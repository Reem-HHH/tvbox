<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lifted soft shadow -->
    <item
        android:left="1dp"
        android:top="6dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22005EB6" />
            <corners android:radius="@dimen/tile_corner" />
        </shape>
    </item>
    <item
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_white" />
            <stroke
                android:width="@dimen/tile_stroke_focused"
                android:color="@color/focus_sky" />
            <corners android:radius="@dimen/tile_corner" />
        </shape>
    </item>
</layer-list>
