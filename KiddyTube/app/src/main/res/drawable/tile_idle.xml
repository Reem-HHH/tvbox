<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#14001E3A" />
            <corners android:radius="@dimen/tile_corner" />
        </shape>
    </item>
    <item
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_white" />
            <stroke
                android:width="@dimen/tile_stroke"
                android:color="@color/card_border" />
            <corners android:radius="@dimen/tile_corner" />
        </shape>
    </item>
</layer-list>
