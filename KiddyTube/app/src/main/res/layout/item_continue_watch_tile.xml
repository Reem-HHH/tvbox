<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/continue_watch_tile_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/tile_margin"
    android:background="@drawable/tile_focus_bg"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <ImageView
        android:id="@+id/videoThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/videoTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/tile_title_area_height"
        android:layout_marginTop="@dimen/tile_title_gap"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="@dimen/tile_title_padding"
        android:paddingEnd="@dimen/tile_title_padding"
        android:textColor="@color/ink_navy"
        android:textSize="@dimen/video_title_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoThumb" />
</androidx.constraintlayout.widget.ConstraintLayout>
