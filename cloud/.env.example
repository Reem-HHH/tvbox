# Copy to .env and edit before first run (local).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
SECRET_KEY=replace-with-a-long-random-string

# Local SQLite (default) OR Neon Postgres for production-like testing:
DATABASE_URL=sqlite:///./data/kiddytube.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Public HTTPS URL of this service (used in docs / pairing tips)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Shared with Flutter builds (must match CLOUD_ENROLL_SECRET in local_defines.json).
# Long random string. Leave empty to disable auto-enroll.
DEVICE_ENROLL_SECRET=replace-with-long-random-family-secret
