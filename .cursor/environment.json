{
  "name": "Kids TV Launcher",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "cd KidsTVLauncher && printf 'sdk.dir=%s\\n' \"${ANDROID_HOME:-/opt/android-sdk}\" > local.properties && ./gradlew --no-daemon assembleDebug",
  "ports": [
    { "name": "player preview", "port": 8765 }
  ],
  "terminals": [
    {
      "name": "player-preview",
      "command": "cd KidsTVLauncher && python3 tools/preview.py",
      "description": "Serves the Kids TV player at http://127.0.0.1:8765/player.html for browser preview of channels and remote controls."
    }
  ]
}
